# Copy this file to .env and adapt it to the host.
# .env is intentionally ignored by Git and must never contain committed secrets.

# Persistent Crafty runtime data. Keep this outside the Git working tree.
CRAFTY_DATA_DIR=/srv/crafty

# Time zone used by Crafty and its scheduled tasks.
TZ=Etc/UTC

# Host port for Crafty's HTTPS web interface.
# Protect this port with LAN/VPN/firewall/reverse-proxy access controls.
CRAFTY_HTTPS_PORT=8443

# Small host/container port range available for Minecraft Java servers.
# Every simultaneously running server needs a unique port in this range.
MC_JAVA_PORT_RANGE=25565-25575
